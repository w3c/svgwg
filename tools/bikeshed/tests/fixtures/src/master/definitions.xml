<!-- Tiny definitions file for the tests, same format as master/definitions.xml. -->
<definitions xmlns='http://mcc.id.au/ns/local' xmlns:x='http://mcc.id.au/ns/local'>

  <element
      name='rect'
      href='shapes.html#RectElement'
      contentmodel='anyof'
      elementcategories='descriptive'
      elements='script'
      attributecategories='core, presentation'
      geometryproperties='x, width'
      attributes='pathLength'
      interfaces='SVGRectElement'>
    <attribute name='rx' href='shapes.html#RectElementRXAttribute' animatable='yes'/>
  </element>

  <element
      name='circle'
      href='shapes.html#CircleElement'
      contentmodel='anyof'
      elementcategories='descriptive'
      attributecategories='core'
      interfaces='SVGCircleElement'/>

  <element
      name='desc'
      href='intro.html#DescElement'
      contentmodel='any'
      attributecategories='core'
      interfaces='SVGElement'/>

  <element
      name='script'
      href='intro.html#ScriptElement'
      contentmodel='text'
      attributecategories='core, other'
      interfaces='SVGElement'>
    <x:contentmodel xmlns='http://www.w3.org/1999/xhtml'>Script text, see <a>'desc'</a>.</x:contentmodel>
    <attribute name='type' href='intro.html#ScriptElementTypeAttribute' animatable='no'/>
  </element>

  <elementcategory name='shape' href='shapes.html#TermShapeElement' elements='rect, circle'/>
  <elementcategory name='descriptive' href='intro.html#TermDescriptiveElement' elements='desc'/>

  <attribute name='x' elements='rect' href='shapes.html#RectElementXAttribute' animatable='yes'/>
  <attribute name='pathLength' href='shapes.html#PathLengthAttribute' animatable='yes'/>

  <attributecategory name='core' href='intro.html#TermCoreAttribute'>
    <attribute name='id' href='intro.html#IDAttribute'/>
    <attribute name='class' href='intro.html#ClassAttribute' animatable='yes'/>
    <attribute name='dup' href='intro.html#CoreDupAttribute'/>
  </attributecategory>
  <attributecategory name='presentation' href='intro.html#TermPresentationAttribute' presentationattributes='fill'/>
  <attributecategory name='other' href='intro.html#TermOtherAttribute'>
    <attribute name='dup' href='intro.html#OtherDupAttribute'/>
    <attribute name='lone' href='intro.html#LoneAttribute'/>
  </attributecategory>

  <property name='fill' href='shapes.html#FillProperty'/>
  <property name='x' href='shapes.html#XProperty'/>
  <property name='width' href='shapes.html#WidthProperty'/>

  <interface name='SVGRectElement' href='shapes.html#InterfaceSVGRectElement'/>
  <interface name='SVGCircleElement' href='shapes.html#InterfaceSVGCircleElement'/>
  <interface name='SVGElement' href='intro.html#InterfaceSVGElement'/>

  <symbol name='length' href='intro.html#DataTypeLength'/>

  <term name='user agent' href='intro.html#TermUserAgent'/>
  <term name='Anim.' href='intro.html#TermAnimatable'/>
  <term name='CTM' href='intro.html#TermCTM'><abbr xmlns='http://www.w3.org/1999/xhtml' title='current transformation matrix'>CTM</abbr></term>
</definitions>
