{
  "_comment": "Tiny configuration for the tests, same keys as config/svg2.json.",
  "source_dir": "master",
  "publish_xml": "publish.xml",
  "published_base": "https://w3c.github.io/svgwg/svg2-draft/",
  "skip_pages": ["Overview"],
  "single_page_aliases": true,
  "keep_straight_apostrophes": true,
  "type_handwritten_links": true,
  "edit_with_to_link_for_hint": true,
  "typed_link_policy": {"element": "section", "interface": "section"},
  "link_resources": ["images"],
  "class_renames": {"propdef": "svg-propdef"},
  "host_rewrites": [["^https?://drafts\\.fxtf\\.org/", "https://drafts.csswg.org/"]],
  "reserved_ids": ["abstract", "status", "toc"],
  "metadata": {"Shortname": "tiny", "Level": "none"},
  "anchors": [
    "url: https://dom.spec.whatwg.org/#interface-element; spec: DOM; type: interface; text: Element"
  ],
  "extra_css": [".tiny { color: red; }"],
  "body_end_html": ["<script src=\"style/expanders.js\"></script>"],
  "idl_keyword_links": {"setter": "__svg__SVGNameList__setter"},
  "single_page_drop_headings": ["idl-index"]
}
