};</pre>

<p>The
<dfn id="__svg__SVGForeignObjectElement__x" data-dfn-type="attribute" data-dfn-for="SVGForeignObjectElement" data-lt="x" oldids="embedded-__svg__SVGForeignObjectElement__x">x</dfn>,
<dfn id="__svg__SVGForeignObjectElement__y" data-dfn-type="attribute" data-dfn-for="SVGForeignObjectElement" data-lt="y" oldids="embedded-__svg__SVGForeignObjectElement__y">y</dfn>,
<dfn id="__svg__SVGForeignObjectElement__width" data-dfn-type="attribute" data-dfn-for="SVGForeignObjectElement" data-lt="width" oldids="embedded-__svg__SVGForeignObjectElement__width">width</dfn> and
<dfn id="__svg__SVGForeignObjectElement__height" data-dfn-type="attribute" data-dfn-for="SVGForeignObjectElement" data-lt="height" oldids="embedded-__svg__SVGForeignObjectElement__height">height</dfn> IDL attributes
