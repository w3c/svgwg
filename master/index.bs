<style>
/* Bikeshed draws <...> around element links; SVG 2 already puts curly quotes around them. */
.element-name a[data-link-type=element]::before, .element-name a[data-link-type=element]::after { content: none; }
/* <{rect}> wraps the link in <code>; without this the element name would get the code size twice (90% of 90%). */
.element-name > code { font-size: inherit; }
</style>

